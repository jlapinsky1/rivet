{
  "name": "junk-removal-quoter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/commercial/property-management-cleanup",
      "/commercial/apartment-cleanouts",
      "/commercial/eviction-cleanup",
      "/commercial/unit-turnover-cleanout",
      "/commercial/bulk-trash-removal",
      "/commercial/illegal-dumping-removal",
      "/commercial/client-portal",
      "/commercial/service-area"
    ],
    "skipThirdPartyRequests": true,
    "headless": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.10",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^1.25.0",
    "pdfkit": "^0.19.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1",
    "stripe": "^22.3.2",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "react-snap": "^1.23.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^7.0.2",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
